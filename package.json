{
  "name": "criterio-aprender-a-invertir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma educativa para aprender a invertir desde cero (España).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-check.mjs",
    "preview": "astro preview",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "check:content": "node scripts/content-check.mjs",
    "verify": "npm run test && npm run check:content && npm run build",
    "audit:browser": "node tests/e2e/audit.mjs && node tests/e2e/progress.mjs",
    "og": "python3 scripts/assets/make-og.py"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "js-yaml": "^4.1.0"
  }
}
