---
/**
 * Área «Formación para empresas». Se entra con la contraseña de la empresa («umotion» + su nombre),
 * que comprueba el servidor (api/empresas.js). Aquí no hay contenido privado: lo envía la API solo con sesión.
 */
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
const lock = 'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z';
---
<Base title="Formación para empresas" description="Área privada de umotion Academy para empresas clientes: formaciones de Claude y ChatGPT adaptadas a cada empresa." noindex={true} allowAds={false}>
  <div class="narrow emp-page">
    <Breadcrumbs items={[{ href: '/es/', label: 'Inicio' }, { label: 'Formación para empresas' }]} />
    <section class="panel-dark box" aria-labelledby="emp-h">
      <p class="mono small k">Área privada</p>
      <h1 id="emp-h">Formación para empresas</h1>
      <p class="lead" id="emp-lead">Claude y ChatGPT adaptados a lo que hace tu empresa y a lo que tu equipo necesita mejorar. Entra con la contraseña que te hemos dado.</p>

      <form id="emp-login" class="login" hidden>
        <label for="emp-pass">Contraseña de tu empresa</label>
        <div class="row">
          <input id="emp-pass" name="password" type="password" required autocomplete="current-password" maxlength="200" />
          <button class="btn brand" type="submit">Entrar</button>
        </div>
        <p class="small hint">Te la damos al contratar la formación.</p>
      </form>

      <div id="emp-area" hidden>
        <p class="who">Formación de <strong id="emp-name"></strong></p>
        <ul class="items" id="emp-programs">
          <li data-default><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={lock} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span><strong>Claude para tu empresa</strong><span class="small">En preparación: la diseñamos con tu equipo según lo que hacéis y lo que necesitáis mejorar.</span></span></li>
          <li data-default><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={lock} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span><strong>ChatGPT para tu empresa</strong><span class="small">En preparación: la diseñamos con tu equipo según lo que hacéis y lo que necesitáis mejorar.</span></span></li>
        </ul>
        <button class="btn ghost small" type="button" id="emp-out">Salir</button>
      </div>

      <p class="small status" id="emp-status" role="status" aria-live="polite"></p>
    </section>
    <p class="small muted">¿Quieres esta formación para tu empresa? Escríbenos desde <a href="/es/contacto/">contacto</a>.</p>
  </div>
</Base>
<style>
  .emp-page { padding-bottom: 4rem; display: grid; gap: 1rem; }
  .box { padding: 1.6rem; }
  .k { margin: 0; color: var(--u-cyan); text-transform: uppercase; letter-spacing: 0.08em; }
  .box h1 { color: #f8f9fc; margin: 0.3rem 0 0.6rem; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); letter-spacing: -0.03em; }
  .lead { color: #c4cada; max-width: 56ch; margin: 0 0 1.2rem; }
  .login label { display: block; font-weight: 600; color: #f2f4fa; margin-bottom: 0.4rem; }
  .row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .row input { flex: 1 1 220px; background: #111527; color: #f2f4fa; border: 1px solid #333c5a; }
  .hint { color: #a3acc4; margin: 0.5rem 0 0; }
  .who { color: #c4cada; margin: 0 0 0.8rem; }
  .who strong { color: #f8f9fc; }
  .items { list-style: none; padding: 0; margin: 0 0 1.2rem; display: grid; gap: 0.6rem; }
  @media (min-width: 560px) { .items { grid-template-columns: 1fr 1fr; } }
  .items :global(li) { display: flex; align-items: flex-start; gap: 0.7rem; padding: 0.85rem; border: 1px solid #2a3150; border-radius: 14px; background: #111527; color: #a3acc4; }
  .items :global(li svg) { flex: none; margin-top: 2px; }
  .items :global(li > span) { display: flex; flex-direction: column; gap: 0.2rem; }
  .items :global(strong) { color: #f2f4fa; }
  .status { color: #ffb4a8; margin: 0.6rem 0 0; font-weight: 600; }
  .status:empty { display: none; }
  .box .btn.ghost { color: #f2f4fa; border-color: #333c5a; }
</style>
<script>
  import { guard, waitMinimum } from '../../../scripts/bot-guard';
  const $ = (id: string) => document.getElementById(id)!;
  const form = $('emp-login') as HTMLFormElement;
  const area = $('emp-area');
  const status = $('emp-status');
  const bot = guard(form);
  type View = { name: string; slug: string; programs: { id: string; title: string; status?: string }[] };

  function show(v: View | null) {
    form.hidden = !!v; area.hidden = !v;
    if (!v) return;
    $('emp-name').textContent = v.name;
    document.querySelectorAll('#emp-programs [data-default] strong').forEach((s, i) => { s.textContent = `${i ? 'ChatGPT' : 'Claude'} para ${v.name}`; });
    // Cuando haya formaciones creadas para la empresa, la API las devuelve y sustituyen a las de «en preparación».
    if (v.programs.length) {
      $('emp-programs').replaceChildren(...v.programs.map((p) => {
        const li = document.createElement('li');
        const span = document.createElement('span');
        const t = document.createElement('strong'); t.textContent = p.title;
        const s = document.createElement('span'); s.className = 'small'; s.textContent = p.status ?? 'Disponible pronto';
        span.append(t, s); li.append(span); return li;
      }));
    }
  }

  async function load() {
    try {
      const r = await fetch('/api/empresas', { credentials: 'same-origin' });
      const d = r.ok ? await r.json() : {};
      if (d.active === false) { status.textContent = 'El área de empresas aún no está activada.'; form.hidden = false; return; }
      show(d.session ? d : null);
    } catch { form.hidden = false; status.textContent = 'No se pudo conectar. Inténtalo de nuevo.'; }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = ($('emp-pass') as HTMLInputElement).value;
    if (bot.payload().hp) { status.textContent = 'No hemos podido comprobar el acceso.'; return; }
    status.textContent = 'Comprobando…';
    await waitMinimum(bot);
    try {
      const r = await fetch('/api/empresas', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password, bot: bot.payload() }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { status.textContent = d.error ?? 'No se pudo entrar.'; return; }
      status.textContent = '';
      ($('emp-pass') as HTMLInputElement).value = '';
      show(d as View);
    } catch { status.textContent = 'No se pudo conectar. Inténtalo de nuevo.'; }
  });

  $('emp-out').addEventListener('click', async () => {
    await fetch('/api/empresas', { method: 'DELETE', credentials: 'same-origin' }).catch(() => {});
    show(null);
    status.textContent = 'Has salido del área de empresas.';
  });
  load();
</script>
