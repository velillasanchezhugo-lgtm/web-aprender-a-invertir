---
/** Presentación del Nivel 1 (gratis). Docs: docs/CURRICULO.md, sección 5. */
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import curriculum from '../../../data/curriculum.json';
import { sessions, TRACKS } from '../../../lib/content';
const t = curriculum.tiers.find((x) => x.n === 1)!;
const all = await sessions();
const count = (id: string) => all.filter((s) => s.data.track === id).length;
const href = (id: string) => (id === 'camino-cero' ? '/es/camino-cero/' : `/es/modulos/${id}/`);
const STAGES = [
  { stage: 'Etapa A', title: 'Camino Cero', desc: 'Lo básico antes de poner un euro: para qué inviertes, colchón y deudas.', tracks: ['camino-cero'] },
  { stage: 'Etapa B · núcleo', title: 'Lo esencial para invertir', desc: 'Qué es cada producto, cómo invertir, dar el primer paso y mantener el rumbo.', tracks: ['productos', 'formas', 'invertir-ya', 'trade-republic', 'mantener'] },
  { stage: 'Ampliación (opcional)', title: 'Para saber más', desc: 'Cuando ya tengas tu plan en marcha.', tracks: ['empresas', 'noticias', 'trading'] },
] as const;
const total = STAGES.flatMap((s) => s.tracks).reduce((a, id) => a + count(id), 0);
---
<Base title={`Nivel 1 · ${t.title}`} description={t.promise} allowAds={false}>
  <section class="tp-hero dots">
    <div class="container">
      <Breadcrumbs items={[{ href: '/es/', label: 'Inicio' }, { href: '/es/niveles/', label: 'Niveles' }, { label: 'Nivel 1' }]} />
      <p class="eyebrow"><span>Nivel 1 · Gratis · disponible ya</span></p>
      <h1>{t.title}</h1>
      <p class="sub">Desde cero, sin fórmulas</p>
      <p class="lede">{t.promise}</p>
      <ul class="facts">
        <li><strong>{total}</strong> sesiones</li>
        <li><strong>{t.format}</strong></li>
        <li><strong>{t.forWho}</strong></li>
        <li><strong>{t.recognition}</strong></li>
      </ul>
      <div class="cta-row">
        <a class="btn brand" href="/es/empezar/">Empezar gratis</a>
        <a class="btn ghost" href="/es/camino-cero/">Ir al Camino Cero</a>
      </div>
    </div>
  </section>
  <div class="container tp">
    <h2 class="h3">Cómo está organizado</h2>
    <p class="small muted">El orden es una recomendación: tu plan personal puede adelantar lo que más te interese.</p>
    <ol class="stages">
      {STAGES.map((s) => (
        <li class="card stage">
          <p class="mono small st">{s.stage}</p>
          <h3>{s.title}</h3>
          <p class="small muted">{s.desc}</p>
          <ul class="tracks">
            {s.tracks.map((id) => <li><a href={href(id)}><span class="tl"><strong>{TRACKS[id].label}</strong><span class="small muted">{TRACKS[id].short}</span></span><span class="mono small n">{count(id)} ses.</span></a></li>)}
          </ul>
        </li>
      ))}
    </ol>
    <h2 class="h3">Al terminar sabrás</h2>
    <ul class="caps">{curriculum.n1Capacities.map((c) => <li>{c.text}</li>)}</ul>
    <section class="card closing">
      <h2 class="h3">Cómo se termina</h2>
      <p>{t.closing}. Reconocimiento: {t.recognition}.</p>
      <ul class="end">
        <li><a href="/es/plan-en-una-pagina/">Mi plan en una página</a></li>
        <li><a href="/es/examen/n1/">Examen del Nivel 1</a></li>
        <li><a href="/es/insignia/">Mi insignia</a></li>
      </ul>
      <p class="small muted">¿Quieres seguir? <a href="/es/nivel-2/">Nivel 2 · Avanzado</a>.</p>
    </section>
  </div>
</Base>
<style>
  .tp-hero { border-bottom: 1px solid var(--rule); padding: 0.5rem 0 2rem; margin-bottom: 1.5rem; }
  .tp-hero h1 { font-size: clamp(2.4rem, 1.7rem + 3.4vw, 4.4rem); margin: 0.2rem 0 0.2rem; }
  .sub { font-size: 1.2rem; color: var(--teal); font-weight: 600; margin: 0 0 0.6rem; }
  .facts { list-style: none; padding: 0; margin: 1.2rem 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .facts li { padding: 0.45rem 0.8rem; border-radius: 999px; background: var(--card); border: 1px solid var(--rule); font-size: 0.92rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tp { padding-bottom: 3rem; }
  .h3 { font-size: 1.4rem; margin: 1.6rem 0 0.4rem; }
  .stages { list-style: none; padding: 0; display: grid; gap: 0.8rem; grid-template-columns: minmax(0, 1fr); }
  .stage h3 { margin: 0.1rem 0 0.2rem; font-size: 1.15rem; }
  .st { margin: 0; color: var(--teal); text-transform: uppercase; letter-spacing: 0.06em; }
  .tracks { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.35rem; }
  .tracks a { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; padding: 0.6rem 0.75rem; border-radius: 12px; border: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .tracks a:hover { background: var(--paper-2); }
  .tl { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .n { flex: none; color: var(--ink-3); }
  .caps { padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .closing { margin-top: 1.5rem; }
  .closing .h3 { margin-top: 0; }
  .end { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; padding: 0; list-style: none; }
</style>
