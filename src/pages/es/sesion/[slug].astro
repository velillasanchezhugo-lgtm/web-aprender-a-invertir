---
import SessionPlayer from '../../../components/SessionPlayer.astro';
import { sessions, TRACKS, type Session } from '../../../lib/content';
export async function getStaticPaths() {
  const all = await sessions();
  return all.map((s) => {
    const mod = all.filter((x) => x.data.track === s.data.track);
    const i = mod.indexOf(s);
    return { params: { slug: s.id }, props: { s, index: i, total: mod.length, next: mod[i + 1] ?? null } };
  });
}
const { s, index, total, next } = Astro.props as { s: Session; index: number; total: number; next: Session | null };
---
<SessionPlayer s={s} index={index} total={total} next={next} trackLabel={TRACKS[s.data.track].label} />
