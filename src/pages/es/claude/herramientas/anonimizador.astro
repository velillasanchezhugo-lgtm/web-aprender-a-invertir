---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
---
<Base title="Quita datos personales antes de usar una IA" description="Pega un texto y sustituye DNI, NIE, IBAN, teléfonos, correos y tarjetas por etiquetas antes de enviarlo a Claude u otra IA. Funciona sin conexión." allowAds={false}>
  <div class="container ct">
    <Breadcrumbs items={[{ href: '/es/', label: 'Inicio' }, { href: '/es/claude/', label: 'Claude' }, { href: '/es/claude/herramientas/', label: 'Herramientas' }, { label: 'Quitar datos personales' }]} />
    <h1>Quita datos personales</h1>
    <p class="lede">Antes de pegar un correo, un contrato o una hoja en Claude, cambia los datos personales por etiquetas como <span class="mono">[DNI 1]</span>. El texto no sale de tu navegador.</p>
    <div class="ct-grid">
      <div class="field"><label for="an-in">Tu texto</label><textarea id="an-in" rows="10" maxlength="20000" placeholder="Pega aquí el texto. Por ejemplo: Hola, soy Marta (DNI 12345678Z), mi teléfono es 612 345 678…"></textarea></div>
      <div class="field"><label for="an-out">Texto sin datos personales</label><textarea id="an-out" rows="10" readonly></textarea></div>
    </div>
    <p id="an-found" class="small" aria-live="polite"></p>
    <p><button type="button" class="btn brand small" id="an-copy">Copiar el texto limpio</button></p>
    <div class="callout note"><p class="callout-title">Revisa siempre a mano</p><p>Esta herramienta reconoce DNI y NIE (comprobando la letra), IBAN, números de tarjeta, teléfonos españoles y correos. No reconoce <strong>nombres, direcciones, matrículas, datos de salud ni detalles que identifiquen a alguien</strong> («la vecina del 3.º que trabaja en…»). Cámbialos tú antes de pegar.</p></div>
  </div>
</Base>
<style>
  .ct { padding-bottom: 3rem; }
  .ct-grid { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 900px) { .ct-grid { grid-template-columns: 1fr 1fr; } }
  textarea { width: 100%; font: 0.95rem/1.5 var(--sans); }
</style>
<script>
  import { anonymize } from '../../../../lib/claude/anonymize';
  const i = document.getElementById('an-in') as HTMLTextAreaElement, o = document.getElementById('an-out') as HTMLTextAreaElement, f = document.getElementById('an-found')!;
  function upd() {
    const r = anonymize(i.value);
    o.value = r.text;
    f.textContent = !i.value.trim() ? '' : r.total ? `He cambiado ${r.total} ${r.total === 1 ? 'dato' : 'datos'}: ${r.found.map((x) => `${x.label} (${x.count})`).join(', ')}. Revisa nombres y direcciones a mano.` : 'No he encontrado DNI, IBAN, teléfonos, correos ni tarjetas. Revisa nombres y direcciones a mano.';
  }
  i.addEventListener('input', upd);
  document.getElementById('an-copy')!.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(o.value); b.textContent = 'Copiado ✓'; } catch { o.select(); b.textContent = 'Selecciona y copia'; }
    setTimeout(() => { b.textContent = 'Copiar el texto limpio'; }, 1800);
  });
</script>
