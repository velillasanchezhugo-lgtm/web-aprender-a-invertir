---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { CLAUDE_TOOLS, toolHref } from '../../../../lib/claude/tools';
---
<Base title="Herramientas para aprender a usar Claude" description="Evaluador de peticiones, constructor de prompts, plantillas para copiar y una herramienta para quitar datos personales antes de usar una IA. Todo en tu navegador." allowAds={false}>
  <div class="container ct">
    <Breadcrumbs items={[{ href: '/es/', label: 'Inicio' }, { href: '/es/claude/', label: 'Claude' }, { label: 'Herramientas' }]} />
    <h1>Herramientas</h1>
    <p class="lede">Para practicar lo que aprendes en la formación: escribe peticiones, compáralas con las piezas de una buena petición y prepara tus textos antes de pegarlos en Claude.</p>
    <div class="grid cols-2">
      {Object.entries(CLAUDE_TOOLS).map(([id, t]) => (
        <a class="card tool-card" href={toolHref(id)}><h2 class="h3">{t.title}</h2><p class="small">{t.blurb}</p><span class="small go">Abrir →</span></a>
      ))}
    </div>
    <div class="callout note"><p class="callout-title">Tus textos, en tu dispositivo</p><p>Las herramientas funcionan en tu navegador. Solo el botón «Opinión de Claude» del evaluador envía tu petición a la IA para corregirla, y únicamente cuando lo pulsas. umotion Academy no está afiliada a Anthropic.</p></div>
  </div>
</Base>
<style>.ct { padding-bottom: 3rem; } .h3 { font-size: 1.2rem; margin: 0 0 0.4rem; } .go { color: var(--teal); font-weight: 600; }</style>
