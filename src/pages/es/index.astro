---
import Base from '../../layouts/Base.astro';
import Postits from '../../components/Postits.astro';
import { HUBS } from '../../lib/hubs';
import { sessions } from '../../lib/content';
import { FORMATION_IDS, formationSessions } from '../../lib/formations';
/** Portada de la academia: un pósit por formación y, si ya has empezado alguna, «Continuar». */
const items = HUBS.map((h) => ({ cls: h.cls, kicker: '3 niveles', title: h.title, text: h.text, href: h.href }));
// Sesiones del Nivel 1 de cada formación, para saber cuántas llevas en cada una.
const counts: Record<string, { store: string; total: number; title: string; href: string }> = {
  inversion: { store: 'academy', total: (await sessions()).length, title: 'Inversión', href: '/es/inversion/' },
};
for (const id of FORMATION_IDS) counts[id] = { store: `academy-${id}`, total: (await formationSessions(id)).length, title: HUBS.find((h) => h.id === id)!.title, href: `/es/${id}/` };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'umotion Academy', url: new URL('/es/', Astro.site).href, inLanguage: 'es-ES', potentialAction: { '@type': 'SearchAction', target: new URL('/es/buscar/?q={q}', Astro.site).href, 'query-input': 'required name=q' } },
  { '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: 'umotion Academy', url: new URL('/es/', Astro.site).href, logo: new URL('/brand/icon-512.png', Astro.site).href, parentOrganization: { '@type': 'Organization', name: 'umotion' } },
];
---
<Base title="Bienvenido a umotion Academy" description="Escuela gratuita para aprender desde cero, en sesiones de 5 minutos: inversión, emprendimiento, Claude y ChatGPT, a tu ritmo y sin que nadie te venda nada." jsonLd={jsonLd} allowAds={false}>
  <section class="hero dots">
    <div class="container">
      <h1>Bienvenido a <span class="grad-text">umotion Academy</span></h1>
      <p class="lede">Una escuela gratuita para aprender desde cero, a tu ritmo y en 5 minutos al día. Elige por dónde empezar.</p>
      <Postits items={items} label="Elige tu formación" labelId="postits-t" />
      <section class="resume-sec" id="resume" aria-labelledby="resume-t" hidden>
        <h2 class="mono small" id="resume-t">Continuar donde lo dejaste</h2>
        <ul class="resume-list" id="resume-list"></ul>
      </section>
    </div>
  </section>
  <section class="container how" aria-labelledby="how-t">
    <h2 class="sr-only" id="how-t">Cómo funciona la academia</h2>
    <ul class="facts">
      <li><strong>5 minutos al día</strong><span class="small">Una idea, un ejemplo, un test y algo que hacer hoy.</span></li>
      <li><strong>Gratis y sin registro</strong><span class="small">El Nivel 1 de cada formación es gratis. La cuenta es opcional.</span></li>
      <li><strong>Tres niveles</strong><span class="small">De cero a profesional, con el mismo sistema en todas las formaciones.</span></li>
      <li><strong>Tu progreso, contigo</strong><span class="small">Se guarda en tu dispositivo, o en tu cuenta si la creas.</span></li>
    </ul>
  </section>
  <script type="application/json" id="home-data" set:html={JSON.stringify(counts)} />
</Base>
<style>
  .hero { padding: 2.5rem 0 3rem; border-bottom: 1px solid var(--rule); background-color: var(--paper); position: relative; overflow: hidden; }
  .hero::after { content: ''; position: absolute; right: -10%; top: -20%; width: 55%; height: 80%; background: radial-gradient(closest-side, color-mix(in srgb, var(--u-cyan) 22%, transparent), transparent); pointer-events: none; }
  .hero > .container { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(2.4rem, 1.5rem + 4vw, 4.4rem); line-height: 1; letter-spacing: -0.045em; margin: 0.3rem 0 1.2rem; }
  .hero .lede { max-width: 62ch; }
  .resume-sec { margin-top: 2rem; max-width: 720px; }
  .resume-sec h2 { margin: 0 0 0.6rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  .resume-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  @media (min-width: 640px) { .resume-list { grid-template-columns: 1fr 1fr; } }
  .resume-list :global(a) { display: flex; flex-direction: column; gap: 0.15rem; text-decoration: none; color: var(--ink); height: 100%; }
  .resume-list :global(strong) { font-size: 1.05rem; }
  .how { margin-top: 2.5rem; margin-bottom: 3rem; }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .facts li { display: flex; flex-direction: column; gap: 0.3rem; border-left: 3px solid var(--u-cyan); padding-left: 0.9rem; }
  :global(.site-footer) { margin-top: 0; }
</style>
<script>
  import { getState, type StoreKey } from '../../scripts/academy-store';
  import { getProgress } from '../../scripts/store';
  const D = JSON.parse(document.getElementById('home-data')!.textContent!) as Record<string, { store: StoreKey; total: number; title: string; href: string }>;
  const list = document.getElementById('resume-list')!;
  for (const f of Object.values(D)) {
    const s = getState(f.store);
    const n = Object.keys(s.completed).length;
    if (!n && !s.plan) continue;
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.className = 'card'; a.href = f.href;
    const t = document.createElement('strong'); t.textContent = f.title;
    const m = document.createElement('span'); m.className = 'small muted'; m.textContent = `${Math.min(n, f.total)} de ${f.total} sesiones del Nivel 1 · Continuar →`;
    a.append(t, m); li.append(a); list.append(li);
  }
  // Si aún no has empezado ninguna formación, la última lectura de la biblioteca.
  const last = getProgress().last;
  if (!list.children.length && last && last.path.startsWith('/es/')) {
    const li = document.createElement('li');
    const a = document.createElement('a'); a.className = 'card'; a.href = last.path;
    const t = document.createElement('strong'); t.textContent = last.title;
    const m = document.createElement('span'); m.className = 'small muted'; m.textContent = 'Tu última lectura · Continuar →';
    a.append(t, m); li.append(a); list.append(li);
  }
  if (list.children.length) document.getElementById('resume')!.hidden = false;
</script>
