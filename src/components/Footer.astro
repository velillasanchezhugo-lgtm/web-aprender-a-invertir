---
import Logo from './Logo.astro';
import { SITE, adsActive } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo size={26} inverse />
        <p>Aprende a invertir en 5 minutos al día. Un producto de <a href={SITE.parentUrl} rel="noopener">umotion</a>.</p>
        <a class="btn small brand" href="/es/empezar/">Crear mi plan <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <nav aria-label="Aprender">
        <h2>Aprender</h2>
        <ul>
          <li><a href="/es/camino-cero/">Camino Cero</a></li>
          <li><a href="/es/modulos/">Módulos</a></li>
          <li><a href="/es/tutor/">Tutor</a></li>
          <li><a href="/es/niveles/">Niveles</a></li>
          <li><a href="/es/mi-plan/">Mi plan</a></li>
          <li><a href="/es/repaso/">Repaso</a></li>
          <li><a href="/es/biblioteca/">Biblioteca</a></li>
          <li><a href="/es/glosario/">Glosario</a></li>
        </ul>
      </nav>
      <nav aria-label="Explorar">
        <h2>Explorar</h2>
        <ul>
          <li><a href="/es/herramientas/">Herramientas</a></li>
          <li><a href="/es/brokers/">Comparador de brókeres</a></li>
          <li><a href="/es/estrategias/">Estrategias</a></li>
          <li><a href="/es/inversores/">Historias de inversores</a></li>
          <li><a href="/es/fuentes/">Fuentes</a></li>
        </ul>
      </nav>
      <nav aria-label="Transparencia y legal">
        <h2>Transparencia</h2>
        <ul>
          <li><a href="/es/alcance-educativo/">Alcance educativo</a></li>
          <li><a href="/es/metodologia/">Metodología</a></li>
          <li><a href="/es/financiacion/">Financiación</a></li>
          <li><a href="/es/correcciones/">Correcciones</a></li>
          <li><a href="/es/aviso-legal/">Aviso legal</a></li>
          <li><a href="/es/privacidad/">Privacidad</a></li>
          <li><a href="/es/cookies/">Cookies</a></li>
          <li><a href="/es/condiciones/">Condiciones</a></li>
          <li><a href="/es/contacto/">Contacto</a></li>
          {adsActive && <li><button type="button" class="linklike" id="privacy-settings">Configurar privacidad</button></li>}
        </ul>
      </nav>
    </div>
    <p class="disclaimer">Contenido educativo general: no tiene en cuenta tu situación personal y no es asesoramiento financiero. Invertir conlleva riesgo de pérdida, incluida la del capital. Rentabilidades pasadas no garantizan resultados futuros.</p>
    <p class="fine">© {year} {SITE.name} · {SITE.parent}.{!SITE.indexable && ' Versión prototipo, no indexada.'}</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--u-ink); color: #a3acc4; padding: 3rem 0 1.5rem; margin-top: 3rem; }
  .site-footer a { color: #e1e6f0; }
  .top { display: grid; gap: 2rem; }
  @media (min-width: 820px) { .top { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
  .about p { margin: 1rem 0; max-width: 36ch; color: #c4cada; }
  .about :global(.logo) { color: #f8f9fc; }
  h2 { font: 500 0.72rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: #737d9a; margin: 0.3rem 0 0.9rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li a, .linklike { display: inline-block; padding: 0.28rem 0; text-decoration: none; font-size: 0.93rem; }
  li a:hover { color: #35c8ff; }
  .linklike { background: none; border: 0; cursor: pointer; color: #e1e6f0; }
  .disclaimer { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid #1c2238; font-size: 0.84rem; max-width: 90ch; }
  .fine { font-size: 0.7rem; color: #737d9a; margin: 0.5rem 0 0; }
  .fine a { color: #737d9a; }
</style>
