---
/**
 * Cartulinas de vocabulario: término (y sigla desplegada) con una definición corta, sobre fondo de puntos.
 */
import { glossaryAll, glossaryList, glossaryFormation } from '../lib/content';
/** `formation`: si se indica, los enlaces llevan al glosario de esa formación (que incluye los términos generales que usa). */
interface Props { ids: string[]; title?: string; intro?: string; headingId?: string; level?: 2 | 3; formation?: string }
const { ids, title, intro, headingId, level = 2, formation } = Astro.props;
const byId = Object.fromEntries(glossaryAll.map((g) => [g.id, g]));
const cards = ids.map((id) => byId[id]).filter(Boolean);
const H = level === 2 ? 'h2' : 'h3';
const inv = new Set(glossaryList.map((g) => g.id));
const more = (id: string) => (formation && formation !== 'inversion' ? `/es/${formation}/glosario/#${id}` : inv.has(id) ? `/es/glosario/#${id}` : `/es/${glossaryFormation[id]}/glosario/#${id}`);
---
{cards.length > 0 && (
  <section class="terms dots" aria-labelledby={headingId}>
    {title && <H id={headingId} class="terms-title">{title}</H>}
    {intro && <p class="terms-intro">{intro}</p>}
    <ul class="term-cards">
      {cards.map((c) => (
        <li class="term-card">
          <span class="tc-pin" aria-hidden="true"></span>
          <strong class="tc-term">{c.term}</strong>
          {c.abbr && <span class="tc-abbr">{c.abbr}</span>}
          <span class="tc-def">{c.short ?? c.def}</span>
          <a class="tc-more" href={more(c.id)}>Más en el glosario<span class="sr-only">: {c.term}</span></a>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .terms { border-radius: 24px; padding: 1.3rem 1.1rem 1.5rem; background-color: var(--paper-2); border: 1px solid var(--rule); }
  .terms-title { font-size: 1.35rem; margin: 0 0 0.3rem; }
  .terms-intro { margin: 0 0 1.1rem; color: var(--ink-2); font-size: 0.98rem; }
  .term-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 620px) { .term-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .term-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .term-card { position: relative; display: flex; flex-direction: column; gap: 0.35rem; padding: 1.15rem 1.1rem 0.9rem; background: var(--card); border: 1px solid var(--rule); border-radius: 14px; box-shadow: var(--shadow); transform: rotate(-1deg); transition: transform .25s var(--ease-seda); }
  .term-card:nth-child(2n) { transform: rotate(0.8deg); }
  .term-card:nth-child(3n) { transform: rotate(-0.4deg); }
  .term-card:hover { transform: rotate(0deg) translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .term-card, .term-card:nth-child(n) { transform: none; transition: none; } }
  .tc-pin { position: absolute; top: -7px; left: 50%; width: 46px; height: 14px; margin-left: -23px; border-radius: 3px; background: var(--u-grad); opacity: 0.85; }
  .tc-term { font: 600 1.3rem/1.15 var(--display); letter-spacing: -0.02em; color: var(--ink); }
  .tc-abbr { font: 500 0.74rem/1.3 var(--mono); color: var(--teal); text-transform: uppercase; letter-spacing: 0.04em; }
  .tc-def { font-size: 1rem; line-height: 1.45; color: var(--ink-2); }
  .tc-more { margin-top: auto; padding-top: 0.4rem; font-size: 0.8rem; }
</style>
