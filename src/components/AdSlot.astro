---
/**
 * Espacio publicitario reservado.
 * Reglas editoriales (ver /es/financiacion/):
 *  - Siempre etiquetado como «Publicidad» y separado del contenido por margen amplio.
 *  - Nunca dentro de ejercicios, cuestionarios, resultados del test, formularios de herramientas
 *    ni junto a botones de navegación de la lección.
 *  - Altura mínima reservada para evitar desplazamientos de diseño (CLS).
 *  - Sin anuncios: no se renderiza nada (salvo marcos de diseño en desarrollo).
 */
import { ADS, adsActive } from '../config/site';
interface Props { slot: keyof typeof ADS.slots; minHeight?: number }
const { slot, minHeight = 280 } = Astro.props;
const slotId = ADS.slots[slot];
const live = adsActive && !!slotId;
const placeholder = !live && ADS.showPlaceholders;
---
{(live || placeholder) && (
  <aside class="ad-slot no-print" aria-label="Publicidad" style={`--ad-min-h:${minHeight}px`}>
    <span class="ad-label">Publicidad</span>
    <div class="ad-box">
      {live ? (
        <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={ADS.client} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
      ) : (
        <span class="ad-placeholder">Espacio publicitario reservado ({slot}, {minHeight}px). Desactivado.</span>
      )}
    </div>
  </aside>
)}
{live && <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>}
