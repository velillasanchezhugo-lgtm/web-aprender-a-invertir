---
/* Marca: logotipo de umotion + «Academy». Versión clara u oscura según el tema. */
interface Props { size?: number; inverse?: boolean }
const { size = 28, inverse = false } = Astro.props;
const w = Math.round(size * 4.02);
---
<span class="logo" style={`--h:${size}px`}>
  {inverse
    ? <img src="/brand/umotion-logo-claro.webp" width={w} height={size} alt="umotion" />
    : <>
        <img class="only-light" src="/brand/umotion-logo-oscuro.webp" width={w} height={size} alt="umotion" />
        <img class="only-dark" src="/brand/umotion-logo-claro.webp" width={w} height={size} alt="umotion" />
      </>}
  <span class="word">Academy</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo img { height: var(--h); width: auto; display: block; }
  .word { font: 500 0.72rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.45em 0.6em; border-radius: 999px; border: 1px solid currentColor; opacity: 0.85; }
</style>
