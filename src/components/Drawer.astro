---
/**
 * Panel lateral de formaciones (se abre desde la izquierda). Árbol desplegable:
 * Formación → niveles → módulos, como los proyectos y sus conversaciones en una barra lateral.
 * De momento solo existe la formación «Inversión».
 */
import curriculum from '../data/curriculum.json';
import { TRACKS } from '../lib/adaptive';
import { PRICING } from '../config/site';
import Price from './Price.astro';
const path = Astro.url.pathname;
const N1_CORE = ['camino-cero', 'productos', 'formas', 'invertir-ya', 'trade-republic', 'mantener'] as const;
const N1_EXTRA = ['empresas', 'noticias', 'trading'] as const;
const trackHref = (t: string) => (t === 'camino-cero' ? '/es/camino-cero/' : `/es/modulos/${t}/`);
const n1Paths = ['/es/camino-cero', '/es/modulos', '/es/sesion', '/es/examen/n1', '/es/examen/cero', '/es/insignia', '/es/plan-en-una-pagina', '/es/niveles'];
const inN1 = n1Paths.some((p) => path.startsWith(p));
const inN2 = path.startsWith('/es/nivel-2');
const inN3 = path.startsWith('/es/nivel-3');
const n2 = [...curriculum.n2.modules].sort((a, b) => curriculum.n2.order.indexOf(a.code) - curriculum.n2.order.indexOf(b.code));
const n3 = curriculum.n3.modules;
const nav = [
  { href: '/es/mi-plan/', label: 'Mi plan' },
  { href: '/es/repaso/', label: 'Repaso' },
  { href: '/es/tutor/', label: 'Tutor' },
  { href: '/es/herramientas/', label: 'Herramientas' },
  { href: '/es/brokers/', label: 'Brókeres' },
  { href: '/es/glosario/', label: 'Glosario' },
  { href: '/es/cuenta/', label: 'Mi cuenta' },
];
const cur = (href: string) => (path === href || (href !== '/es/' && path.startsWith(href)) ? 'page' : undefined);
const lock = 'M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z';
---
<div class="drawer-root" id="drawer" inert>
  <div class="drawer-overlay" data-drawer-close></div>
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
    <div class="dr-head">
      <p class="dr-title" id="drawer-title">Formaciones</p>
      <button type="button" class="dr-close" data-drawer-close aria-label="Cerrar el panel">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <nav class="dr-body" aria-label="Formaciones">
      <ul class="tree">
        <li>
          <details class="course" open>
            <summary>
              <span class="ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M3 20h18M6 16l4-5 3 3 5-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="lbl"><strong>Inversión</strong><span class="meta">3 niveles</span></span>
              <span class="chev" aria-hidden="true"></span>
            </summary>
            <ul class="levels">
              <li>
                <details open={inN1}>
                  <summary><span class="lvn">1</span><span class="lbl"><span>Invertir por tu cuenta</span><span class="meta">Gratis</span></span><span class="chev" aria-hidden="true"></span></summary>
                  <ul class="items">
                    <li><a href="/es/niveles/#nivel-1" aria-current={cur('/es/niveles/')}>Visión general del nivel</a></li>
                    {N1_CORE.map((t) => <li><a href={trackHref(t)} aria-current={cur(trackHref(t))}>{TRACKS[t].label}</a></li>)}
                    <li class="sub">Ampliación</li>
                    {N1_EXTRA.map((t) => <li><a href={trackHref(t)} aria-current={cur(trackHref(t))}>{TRACKS[t].label}</a></li>)}
                    <li class="sub">Cierre</li>
                    <li><a href="/es/plan-en-una-pagina/" aria-current={cur('/es/plan-en-una-pagina/')}>Mi plan en una página</a></li>
                    <li><a href="/es/examen/n1/" aria-current={cur('/es/examen/n1/')}>Examen del Nivel 1</a></li>
                    <li><a href="/es/insignia/" aria-current={cur('/es/insignia/')}>Mi insignia</a></li>
                  </ul>
                </details>
              </li>
              <li>
                <details open={inN2}>
                  <summary><span class="lvn">2</span><span class="lbl"><span>Avanzado</span><span class="meta"><Price text={PRICING.n2.monthly} /></span></span><span class="chev" aria-hidden="true"></span></summary>
                  <ul class="items">
                    <li><a href="/es/nivel-2/" aria-current={path === '/es/nivel-2/' ? 'page' : undefined}>Visión general y temario</a></li>
                    {n2.map((m) => <li><a href={`/es/nivel-2/#mod-${m.code}`}><svg class="lk" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d={lock} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" /></svg>{m.title}</a></li>)}
                  </ul>
                </details>
              </li>
              <li>
                <details open={inN3}>
                  <summary><span class="lvn">3</span><span class="lbl"><span>Profesional</span><span class="meta"><Price text={`curso ${PRICING.n3.course} · certificación ${PRICING.n3.certification}`} /></span></span><span class="chev" aria-hidden="true"></span></summary>
                  <ul class="items">
                    <li><a href="/es/nivel-3/" aria-current={path === '/es/nivel-3/' ? 'page' : undefined}>Visión general y temario</a></li>
                    {n3.map((m) => <li><a href={`/es/nivel-3/#mod-${m.code}`}><svg class="lk" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d={lock} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" /></svg>{m.title}</a></li>)}
                  </ul>
                </details>
              </li>
            </ul>
          </details>
        </li>
        <li class="soon" aria-disabled="true">
          <span class="ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>
          <span class="lbl"><span>Más formaciones</span><span class="meta">Próximamente</span></span>
        </li>
      </ul>
      <p class="dr-sec">Accesos</p>
      <ul class="quick">{nav.map((n) => <li><a href={n.href} aria-current={cur(n.href)}>{n.label}</a></li>)}</ul>
    </nav>
  </aside>
</div>

<style>
  .drawer-root { position: fixed; inset: 0; z-index: 100; pointer-events: none; }
  .drawer-root.open { pointer-events: auto; }
  .drawer-overlay { position: absolute; inset: 0; background: rgb(5 6 11 / 45%); opacity: 0; transition: opacity .25s var(--ease-seda); }
  .drawer-root.open .drawer-overlay { opacity: 1; }
  .drawer { position: absolute; top: 0; bottom: 0; left: 0; width: min(340px, 88vw); background: var(--paper); border-right: 1px solid var(--rule); box-shadow: 0 0 40px rgb(0 0 0 / 25%); transform: translateX(-102%); transition: transform .28s var(--ease-seda); display: flex; flex-direction: column; }
  .drawer-root.open .drawer { transform: none; }
  @media (prefers-reduced-motion: reduce) { .drawer, .drawer-overlay { transition: none; } }
  .dr-head { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 0.9rem 0.6rem 1.1rem; border-bottom: 1px solid var(--rule); }
  .dr-title { margin: 0; font: 600 0.78rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .dr-close { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 0; border-radius: 10px; background: transparent; color: var(--ink-2); cursor: pointer; }
  .dr-close:hover { background: var(--paper-2); }
  .dr-body { overflow-y: auto; padding: 0.6rem 0.6rem 1.5rem; flex: 1; }
  ul { list-style: none; margin: 0; padding: 0; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.6rem; border-radius: 10px; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--paper-2); }
  summary:focus-visible, .items a:focus-visible, .quick a:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .lbl { display: flex; flex-direction: column; gap: 0.05rem; flex: 1; min-width: 0; font-size: 0.95rem; }
  .meta { font: 500 0.72rem/1.3 var(--mono); color: var(--ink-3); }
  .ico { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 9px; background: var(--u-ink); color: var(--u-cyan); flex: none; }
  .chev { width: 8px; height: 8px; border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); transform: rotate(-45deg); transition: transform .2s; flex: none; margin-right: 0.3rem; }
  details[open] > summary > .chev { transform: rotate(45deg); }
  .levels { margin: 0.1rem 0 0.3rem 1.1rem; padding-left: 0.6rem; border-left: 1px solid var(--rule); }
  .lvn { width: 22px; height: 22px; border-radius: 7px; display: inline-grid; place-items: center; font: 600 0.75rem/1 var(--mono); background: var(--paper-2); color: var(--ink-2); border: 1px solid var(--rule-strong); flex: none; }
  .items { margin: 0.1rem 0 0.4rem 0.95rem; padding-left: 0.6rem; border-left: 1px solid var(--rule); }
  .items a { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.6rem; border-radius: 8px; color: var(--ink-2); text-decoration: none; font-size: 0.9rem; line-height: 1.3; }
  .items a:hover { background: var(--paper-2); color: var(--ink); }
  .items a[aria-current='page'], .quick a[aria-current='page'] { background: var(--teal-soft); color: var(--ink); font-weight: 600; }
  .lk { color: var(--ink-3); flex: none; }
  .sub { font: 500 0.68rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); padding: 0.7rem 0.6rem 0.3rem; }
  .soon { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.6rem; opacity: 0.7; }
  .soon .ico { background: var(--paper-2); color: var(--ink-3); }
  .dr-sec { margin: 1.2rem 0.6rem 0.3rem; font: 600 0.7rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .quick a { display: block; padding: 0.55rem 0.6rem; border-radius: 10px; color: var(--ink-2); text-decoration: none; }
  .quick a:hover { background: var(--paper-2); color: var(--ink); }
  :global(body.drawer-open) { overflow: hidden; }
</style>

<script>
  const root = document.getElementById('drawer')!;
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-drawer-open]');
  let last: HTMLElement | null = null;
  function open() {
    last = document.activeElement as HTMLElement;
    root.inert = false; root.classList.add('open'); document.body.classList.add('drawer-open');
    openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    root.querySelector<HTMLElement>('.dr-close')?.focus();
  }
  function close() {
    root.classList.remove('open'); root.inert = true; document.body.classList.remove('drawer-open');
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    last?.focus();
  }
  openers.forEach((b) => b.addEventListener('click', open));
  root.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('open')) close(); });
  // Al elegir un enlace (también los que llevan a una sección de la misma página), se cierra.
  root.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));
  // Mantiene el foco dentro del panel mientras está abierto.
  root.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = [...root.querySelectorAll<HTMLElement>('summary, a, button')].filter((el) => el.offsetParent !== null);
    if (!f.length) return;
    if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
    else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
  });
</script>
