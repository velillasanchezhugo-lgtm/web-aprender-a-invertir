---
/**
 * Reproductor de una sesión de 5 minutos (gancho, idea, práctica, caso, test, acción). Lo usan todas las formaciones:
 * `formation` cambia los enlaces y la clave donde se guarda el progreso (cada formación, el suyo).
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { lessons, TOOLS, sourceById, isoDate, guessFor } from '../lib/content';
import BrokerDisclosure from './BrokerDisclosure.astro';
import TermCards from './TermCards.astro';
import PromptCoach from './PromptCoach.astro';
import { FORMATION_TOOLS, type FormationId } from '../lib/formations';
import { hubById } from '../lib/hubs';
interface Props { s: any; index: number; total: number; next: any | null; trackLabel: string; formation?: string }
const { s, index, total, next, trackLabel, formation = 'inversion' } = Astro.props;
const inv = formation === 'inversion';
const sessionBase = inv ? '/es/sesion/' : `/es/${formation}/sesion/`;
const home = inv ? '/es/mi-plan/' : `/es/${formation}/nivel-1/`;
const storeKey = inv ? 'academy' : `academy-${formation}`;
const ftools = inv ? null : FORMATION_TOOLS[formation as FormationId];
const d = s.data;
const toolLink = d.tool ? (ftools ? { href: `${ftools.href}${d.tool}/`, title: ftools.items[d.tool]?.title } : { href: `/es/herramientas/${d.tool}/`, title: TOOLS[d.tool]?.title }) : null;
const { Content } = await render(s);
const ls = inv ? Object.fromEntries((await lessons()).map((l) => [l.id, l.data.title])) : {};
const nQ = d.questions.length;
const sc = d.scenario;
const K = d.terms?.length ? 1 : 0;
const qBase = (sc ? 4 : 3) + K;
const P = d.practice ? 1 : 0;
const steps = ['Pregunta', ...(K ? ['Palabras clave'] : []), 'La idea', 'En la práctica', ...(sc ? ['Caso práctico'] : []), ...d.questions.map((_: unknown, i: number) => `Test ${i + 1}`), ...(P ? ['Practica'] : []), 'Acción de hoy', 'Hecho'];
const qmeta = Object.fromEntries(d.questions.map((q: any) => [q.id, { skills: q.skills ?? d.skills, guess: guessFor(q) }]));
const jsonLd = { '@context': 'https://schema.org', '@type': 'LearningResource', name: d.title, description: d.description, inLanguage: 'es-ES', timeRequired: `PT${d.minutes}M`, educationalLevel: 'Principiante', learningResourceType: 'Microlección', isAccessibleForFree: true, datePublished: isoDate(d.published), provider: { '@type': 'Organization', name: 'umotion Academy' } };
---
<Base title={`${d.title} · ${trackLabel} ${index + 1}${inv ? '' : ` · ${hubById[formation as FormationId].title}`}`} description={d.description} jsonLd={jsonLd} allowAds={false} focusMode={true}>
  <div class="player" data-id={s.id} data-store={storeKey} data-next={next ? `${sessionBase}${next.id}/` : ''} data-next-title={next?.data.title ?? ''} data-index={index + 1} data-total={total} data-track={d.track} data-track-label={trackLabel}>
    <div class="topbar">
      <div class="container tb-inner">
        <a href={home} class="close" aria-label="Salir de la sesión">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
        <div class="segments" aria-hidden="true">{steps.map(() => <span></span>)}</div>
        <span class="count mono small" aria-live="polite"><span id="step-label">{steps[0]}</span></span>
      </div>
    </div>

    <div class="stage narrow">
      <p class="eyebrow">{trackLabel} · Sesión {index + 1} de {total} · {d.minutes} min</p>

      <section class="step" data-step="0" aria-labelledby="h-hook">
        <h1 id="h-hook" class="title">{d.title}</h1>
        <div class="hook panel-dark">
          <span class="chip">Para empezar</span>
          <p class="hook-q">{d.hook}</p>
          <p class="small hook-hint">Piensa tu respuesta unos segundos. La verás clara en un minuto.</p>
        </div>
      </section>

      {K === 1 && (
        <section class="step keywords" data-step="1" aria-labelledby="h-kw">
          <span class="chip">Palabras clave</span>
          <TermCards formation={formation} ids={d.terms!} title="Antes de empezar, estas palabras" intro="Las vas a ver en esta sesión. Una frase cada una." headingId="h-kw" />
        </section>
      )}

      {d.track === 'trade-republic' && <BrokerDisclosure compact />}
      <div class="body prose" id="session-body"><Content />{d.tips && <aside class="tips" aria-label="Te recomendamos"><p class="tips-title">Te recomendamos</p><ul>{d.tips.map((t: string) => <li>{t}</li>)}</ul></aside>}</div>

      {sc && (
        <section class="step scenario-step" data-step={3 + K} aria-labelledby="h-sc">
          <span class="chip">Caso práctico</span>
          <h2 id="h-sc" class="q-text">Lee este caso: lo usarás en el test</h2>
          <article class={`scenario sc-${sc.kind}`}>
            <p class="sc-label mono small">{sc.label}</p>
            <h3 class="sc-title">{sc.title}</h3>
            <div class="sc-body">{sc.body.split(/\n\n+/).map((para: string) => <p>{para}</p>)}</div>
            {sc.note && <p class="sc-note small">{sc.note}</p>}
          </article>
        </section>
      )}

      {d.questions.map((q: any, i: number) => (
        <section class="step q" data-step={qBase + i} data-qid={q.id} data-type={q.type} aria-labelledby={`h-${q.id}`}>
          <span class="chip">Test {i + 1} de {nQ}</span>
          {sc && <details class="sc-mini"><summary>Ver el caso: {sc.title}</summary><div>{sc.body.split(/\n\n+/).map((para: string) => <p>{para}</p>)}</div></details>}
          <h2 id={`h-${q.id}`} class="q-text">{q.q}</h2>
          {q.type === 'choice' && (
            <div class="opts" role="group" aria-labelledby={`h-${q.id}`}>
              {q.options.map((o: string, j: number) => <button type="button" class="opt" data-v={j} data-correct={j === q.answer ? '1' : undefined}>{o}</button>)}
            </div>
          )}
          {q.type === 'truefalse' && (
            <div class="opts tf" role="group" aria-labelledby={`h-${q.id}`}>
              <button type="button" class="opt" data-v="true" data-correct={q.answer ? '1' : undefined}>Verdadero</button>
              <button type="button" class="opt" data-v="false" data-correct={!q.answer ? '1' : undefined}>Falso</button>
            </div>
          )}
          {q.type === 'estimate' && (
            <div class="estimate" data-answer={q.answer} data-tol={q.tolerance} data-unit={q.unit} data-min={q.min} data-max={q.max}>
              <label for={`r-${q.id}`} class="sr-only">Tu estimación</label>
              <output class="est-val" id={`o-${q.id}`} for={`r-${q.id}`}>{Math.round((q.min + q.max) / 2 / q.step) * q.step} {q.unit}</output>
              <input type="range" id={`r-${q.id}`} min={q.min} max={q.max} step={q.step} value={Math.round((q.min + q.max) / 2 / q.step) * q.step} />
              <div class="est-scale mono small"><span>{q.min} {q.unit}</span><span>{q.max} {q.unit}</span></div>
              <button type="button" class="btn check">Comprobar</button>
            </div>
          )}
          <div class="feedback" role="status" aria-live="polite" hidden>
            <p class="verdict"></p>
            <p class="explain">{q.explain}</p>
            {inv && <p class="tutor-link small" hidden><a href={`/es/tutor/?sesion=${s.id}&pregunta=${q.id}`}>No lo veo claro: pregúntale al tutor →</a></p>}
          </div>
          <noscript><details><summary>Ver la respuesta</summary><p>{q.type === 'choice' ? q.options[q.answer] : q.type === 'truefalse' ? (q.answer ? 'Verdadero' : 'Falso') : `${q.answer} ${q.unit}`}. {q.explain}</p></details></noscript>
        </section>
      ))}

      {P === 1 && (
        <section class="step practice-step" data-step={qBase + nQ} aria-labelledby="h-practice">
          <span class="chip">Practica · escribe tu petición</span>
          <h2 id="h-practice" class="q-text">{d.practice.task}</h2>
          <PromptCoach id={s.id} task={d.practice.task} require={d.practice.require} extra={d.practice.extra} sample={d.practice.sample} />
          <p class="small muted">Puedes seguir sin hacerla, pero escribir la petición es lo que más se aprende. Después, pruébala en Claude.</p>
        </section>
      )}

      <section class="step action" data-step={qBase + nQ + P} aria-labelledby="h-action">
        <span class="chip">Acción de hoy · 2 minutos</span>
        <h2 id="h-action">{d.action.title}</h2>
        <ol class="action-steps">{d.action.steps.map((st: string) => <li>{st}</li>)}</ol>
        {toolLink && <p><a class="btn small secondary" href={toolLink.href} target="_blank" rel="noopener">Abrir: {toolLink.title} ↗</a></p>}
        <label class="choice done-check"><input type="checkbox" id="action-done" /> <span>{d.action.check}</span></label>
        <div class="field"><label for="note">Tu nota (opcional, se queda en tu dispositivo)</label><textarea id="note" rows="2" maxlength="400"></textarea></div>
        {inv && <p class="small muted">Puedes hacerla ahora o más tarde: la encontrarás en «Mi plan».</p>}
      </section>

      <section class="step finish" data-step={qBase + 1 + nQ + P} aria-labelledby="h-finish">
        <div class="panel-dark finish-card">
          <span class="chip">Sesión completada</span>
          <h2 id="h-finish">Hoy te llevas esto:</h2>
          <p class="takeaway">{d.takeaway}</p>
          <div class="stats">
            <div><span class="k mono">Aciertos</span><span class="v" id="f-score">—</span></div>
            <div><span class="k mono">Racha</span><span class="v" id="f-streak">—</span></div>
            <div><span class="k mono">{trackLabel}</span><span class="v" id="f-progress">—</span></div>
          </div>
        </div>
        {inv && (
          <div class="card rec-next" id="rec-next" hidden>
            <p class="eyebrow">Recomendado para ti</p>
            <h3 class="h4"><a id="rec-link" href="#"></a></h3>
            <ul class="rec-why small" id="rec-why"></ul>
          </div>
        )}
        <div class="finish-actions">
          {next ? <a class="btn brand" href={`${sessionBase}${next.id}/`} id="next-btn">Siguiente: {next.data.title} <span class="arrow" aria-hidden="true">→</span></a>
                : inv ? <a class="btn brand" href="/es/examen/cero/">Hacer el examen del nivel Cero <span class="arrow" aria-hidden="true">→</span></a>
                : <a class="btn brand" href={home}>Módulo terminado: ver el Nivel 1 <span class="arrow" aria-hidden="true">→</span></a>}
          {(inv || next) && <a class="btn secondary" href={home}>{inv ? 'Volver a mi plan' : 'Volver al Nivel 1'}</a>}
        </div>
        {inv && <p class="small">¿Te avisamos mañana a las 16:00 para no perder la racha? <a href="/es/cuenta/#recordatorio">Activar el recordatorio</a>.</p>}
        {inv && <p class="small">Mañana repasarás lo que has fallado hoy en <a href="/es/repaso/">Repaso</a>. {d.deeper && <>¿Quieres más? Lee <a href={`/es/lecciones/${d.deeper}/`}>{ls[d.deeper]}</a>.</>}</p>}
        <details class="sources small">
          <summary>Fuentes y revisión</summary>
          <ul>{d.sources.map((id: string) => { const src = sourceById(id); return src && <li>{src.url ? <a href={src.url} rel="noopener" target="_blank">{src.title}</a> : src.title}</li>; })}</ul>
          <p class="muted">{d.author}. Estado: pendiente de revisión humana. Revisado el {d.reviewed.toLocaleDateString('es-ES', { timeZone: 'UTC' })}. Jurisdicción: {d.jurisdiction}. Contenido educativo, no asesoramiento.</p>
        </details>
      </section>

      <nav class="controls no-print" aria-label="Navegación de la sesión">
        <button type="button" class="btn ghost small" id="prev">← Atrás</button>
        <button type="button" class="btn" id="next">Continuar <span class="arrow" aria-hidden="true">→</span></button>
      </nav>
    </div>
  </div>
  <script type="application/json" id="session-data" set:html={JSON.stringify({ questions: d.questions.map((q) => q.id), qmeta, skills: d.skills })} />
</Base>

<style>
  .player { min-height: 100dvh; }
  .topbar { position: sticky; top: var(--header); z-index: 20; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .tb-inner { display: flex; align-items: center; gap: 0.8rem; min-height: 52px; }
  .close { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 999px; color: var(--ink-2); }
  .close:hover { background: var(--paper-2); }
  .segments { flex: 1; display: flex; gap: 4px; }
  .segments span { flex: 1; height: 5px; border-radius: 999px; background: var(--rule); transition: background .4s var(--ease-seda); }
  .segments span.on { background: var(--u-grad); }
  .count { color: var(--ink-3); min-width: 6.5rem; text-align: right; }
  .stage { padding-top: 1.5rem; padding-bottom: 7rem; }
  .title { font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem); margin: 0.2rem 0 1.2rem; }
  .hook { padding: 1.6rem; }
  .hook-q { font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.7rem); line-height: 1.35; font-weight: 600; letter-spacing: -0.015em; margin: 1rem 0 0.6rem; }
  .hook-hint { color: #a3acc4; margin: 0; }
  .step { margin-bottom: 2.5rem; }
  .q-text { font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem); margin: 0.9rem 0 1.2rem; line-height: 1.25; }
  .opts { display: flex; flex-direction: column; gap: 0.75rem; }
  .opt { text-align: left; font: 500 1.05rem/1.5 var(--sans); padding: 1rem 1.1rem; border: 1.5px solid var(--rule-strong); border-radius: 16px; background: var(--card); color: var(--ink); cursor: pointer; transition: border-color .15s, transform .15s var(--ease-seda), background .15s; min-height: 56px; }
  .opts.tf .opt { font-weight: 600; }
  .opt:hover:not(:disabled) { border-color: var(--u-blue); transform: translateY(-1px); }
  .opt.is-correct { border-color: var(--gain); background: color-mix(in srgb, var(--gain) 12%, var(--card)); }
  .opt.is-wrong { border-color: var(--loss); background: var(--loss-soft); }
  .opt:disabled { cursor: default; }
  .estimate { background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.2rem; }
  .est-val { display: block; font: 600 2.4rem/1.1 var(--display); letter-spacing: -0.03em; margin-bottom: 0.6rem; }
  .est-ans { display: block; font: 600 1rem/1.3 var(--sans); color: var(--gain); margin: -0.2rem 0 0.6rem; }
  .est-scale { display: flex; justify-content: space-between; color: var(--ink-3); margin: 0.2rem 0 1rem; }
  .feedback { margin-top: 1rem; padding: 1rem 1.1rem; border-radius: 16px; background: var(--paper-2); border-left: 4px solid var(--ink-3); }
  .feedback.ok { border-left-color: var(--gain); background: color-mix(in srgb, var(--gain) 10%, var(--card)); }
  .feedback.ko { border-left-color: var(--loss); background: var(--loss-soft); }
  .verdict { font-weight: 700; margin-bottom: 0.3rem; }
  .explain { margin: 0; }
  .tips { margin: 1.4rem 0 0; padding: 1.1rem 1.2rem; border-radius: 18px; background: var(--teal-soft); border: 1px solid var(--rule); }
  .tips-title { font: 600 0.78rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--teal); margin: 0 0 0.6rem; }
  .tips ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.45rem; }
  .tips li::marker { color: var(--teal); }
  .scenario { background: var(--card); border: 1px solid var(--rule); border-left: 4px solid var(--u-blue); border-radius: 18px; padding: 1.2rem 1.3rem; box-shadow: var(--shadow); }
  .sc-noticia { border-left-color: var(--ochre); }
  .sc-label { text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 0.4rem; }
  .sc-title { font-size: 1.3rem; line-height: 1.25; margin: 0 0 0.6rem; }
  .sc-body p { margin: 0 0 0.6rem; }
  .sc-note { color: var(--ink-3); margin: 0.4rem 0 0; font-style: italic; }
  .sc-mini { margin: 0.8rem 0 0; font-size: 0.95rem; }
  .sc-mini summary { cursor: pointer; color: var(--teal); font-weight: 600; }
  .sc-mini div { padding: 0.6rem 0.9rem; border-left: 3px solid var(--rule-strong); margin-top: 0.4rem; }
  .sc-mini p { margin: 0 0 0.4rem; }
  .tutor-link { margin: 0.6rem 0 0; }
  .rec-next { margin: 1.2rem 0 0; padding: 1.1rem 1.2rem; }
  .rec-next .eyebrow { margin: 0; }
  .h4 { font-size: 1.2rem; margin: 0.3rem 0 0.4rem; }
  .rec-why { margin: 0; padding-left: 1.1rem; color: var(--ink-2); }
  .action h2 { margin-top: 0.9rem; }
  .action-steps { padding-left: 1.3rem; font-size: 1.08rem; }
  .action-steps li { margin-bottom: 0.6rem; }
  .done-check { margin: 1.2rem 0; }
  .finish-card { padding: 1.6rem; }
  .finish-card h2 { margin: 0.9rem 0 0.4rem; color: #a3acc4; font-size: 1.1rem; font-weight: 500; letter-spacing: 0; }
  .takeaway { font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; margin: 0 0 1.4rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; border-top: 1px solid #232a42; padding-top: 1rem; }
  .stats .k { display: block; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: #a3acc4; }
  .stats .v { font: 600 1.5rem/1.2 var(--display); }
  .finish-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.4rem 0 1rem; }
  .sources { margin-top: 1.5rem; }
  .controls { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.8rem var(--gutter) calc(0.8rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(10px); border-top: 1px solid var(--rule); }
  .controls #next { flex: 1; max-width: 420px; margin-left: auto; }
  :global(.js .player .step), :global(.js .player .body > *) { display: none; }
  :global(.js .player .step.active) { display: block; animation: rise .5s var(--ease-seda) both; }
  :global(.js .player .body > .shown) { display: block; animation: rise .5s var(--ease-seda) both; }
  :global(.js .player .body > ol.shown), :global(.js .player .body > ul.shown) { display: block; }
  :global(html:not(.js)) .controls { display: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>

<script>
  import { getState as load, saveState as store, answer, completeSession, type QMeta, type StoreKey } from '../scripts/academy-store';
  import { grade, streak, type Question } from '../lib/academy';
  import { showRecommendation } from '../scripts/recommend-ui';
  import { track } from '@vercel/analytics';
  const SD = JSON.parse(document.getElementById('session-data')!.textContent!) as { questions: string[]; qmeta: Record<string, QMeta>; skills: string[] };
  const root = document.querySelector<HTMLElement>('.player')!;
  const id = root.dataset.id!;
  // Cada formación guarda su progreso en su propia clave.
  const KEY = (root.dataset.store ?? 'academy') as StoreKey;
  const getState = () => load(KEY);
  const saveState = (st: ReturnType<typeof load>) => store(st, KEY);
  const body = document.getElementById('session-body')!;
  const K = root.querySelector('.keywords') ? 1 : 0;
  const labels = ['Pregunta', ...(K ? ['Palabras clave'] : []), 'La idea', 'En la práctica'];
  // Divide el cuerpo Markdown en los pasos «La idea» y «En la práctica» según sus h2 (lo que sigue, incluidos los consejos, va en el segundo).
  const parts: HTMLElement[][] = [[], []];
  let part = -1;
  [...body.children].forEach((el) => { if (el.tagName === 'H2') part++; if (part >= 0) parts[Math.min(part, 1)].push(el as HTMLElement); });
  const steps = [...root.querySelectorAll<HTMLElement>('.step')];
  // Pasos virtuales 1 y 2 = partes del cuerpo
  const total = steps.length + 2;
  const qSteps = steps.filter((s) => s.classList.contains('q'));
  if (root.querySelector('.scenario-step')) labels.push('Caso práctico');
  qSteps.forEach((_, i) => labels.push(`Test ${i + 1}`));
  if (root.querySelector('.practice-step')) labels.push('Practica');
  labels.push('Acción de hoy', 'Hecho');
  const segs = [...root.querySelectorAll<HTMLElement>('.segments span')];
  const prevBtn = document.getElementById('prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('next') as HTMLButtonElement;
  const label = document.getElementById('step-label')!;
  const answered = new Map<string, boolean>();
  let cur = 0;

  function show(i: number) {
    cur = Math.max(0, Math.min(total - 1, i));
    steps.forEach((s) => s.classList.remove('active'));
    body.querySelectorAll('.shown').forEach((e) => e.classList.remove('shown'));
    if (cur === 0) steps[0].classList.add('active');
    else if (cur > K && cur <= 2 + K) parts[cur - 1 - K].forEach((e) => e.classList.add('shown'));
    else steps.find((s) => Number(s.dataset.step) === cur)?.classList.add('active');
    segs.forEach((s, k) => s.classList.toggle('on', k <= cur));
    label.textContent = labels[cur];
    prevBtn.style.visibility = cur === 0 || cur === total - 1 ? 'hidden' : 'visible';
    const active = steps.find((s) => Number(s.dataset.step) === cur);
    const isQ = active?.classList.contains('q');
    nextBtn.hidden = cur === total - 1;
    nextBtn.disabled = !!isQ && !answered.has(active!.dataset.qid!);
    nextBtn.innerHTML = cur === total - 2 ? 'Terminar sesión <span class="arrow" aria-hidden="true">→</span>' : 'Continuar <span class="arrow" aria-hidden="true">→</span>';
    if (cur === total - 1) finish();
    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
    const h = cur === 0 ? steps[0].querySelector('h1') : cur > K && cur <= 2 + K ? parts[cur - 1 - K][0] : active?.querySelector('h2');
    (h as HTMLElement | null)?.setAttribute('tabindex', '-1');
    (h as HTMLElement | null)?.focus({ preventScroll: true });
  }

  function record(step: HTMLElement, ok: boolean, given: string) {
    const qid = step.dataset.qid!;
    if (answered.has(qid)) return;
    answered.set(qid, ok);
    let st = getState(); st = answer(st, qid, ok, SD.qmeta[qid]); saveState(st);
    const fb = step.querySelector<HTMLElement>('.feedback')!;
    fb.hidden = false; fb.classList.add(ok ? 'ok' : 'ko');
    fb.querySelector('.verdict')!.textContent = ok ? '¡Correcto!' : `No exactamente. ${given}`;
    if (!ok) fb.querySelector<HTMLElement>('.tutor-link')?.removeAttribute('hidden');
    nextBtn.disabled = false;
    nextBtn.focus();
  }

  qSteps.forEach((step) => {
    step.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
      if (answered.has(step.dataset.qid!)) return;
      const ok = b.dataset.correct === '1';
      step.querySelectorAll<HTMLButtonElement>('.opt').forEach((o) => { o.disabled = true; if (o.dataset.correct === '1') o.classList.add('is-correct'); });
      if (!ok) b.classList.add('is-wrong');
      b.setAttribute('aria-pressed', 'true');
      const right = step.querySelector<HTMLElement>('.opt[data-correct="1"]')!.textContent;
      record(step, ok, `La respuesta correcta es: «${right}».`);
    }));
    const est = step.querySelector<HTMLElement>('.estimate');
    if (est) {
      const range = est.querySelector<HTMLInputElement>('input[type=range]')!;
      const out = est.querySelector('output')!;
      const unit = est.dataset.unit!;
      const fmt = (v: number) => `${v.toLocaleString('es-ES')} ${unit}`;
      range.addEventListener('input', () => (out.textContent = fmt(Number(range.value))));
      est.querySelector('.check')!.addEventListener('click', (e) => {
        const v = Number(range.value);
        const q = { type: 'estimate', answer: Number(est.dataset.answer), tolerance: Number(est.dataset.tol) } as Extract<Question, { type: 'estimate' }>;
        const ok = grade(q, v);
        range.disabled = true; (e.target as HTMLButtonElement).disabled = true;
        const ans = document.createElement('span'); ans.className = 'est-ans'; ans.textContent = `Respuesta: ${fmt(q.answer)}`; out.after(ans);
        record(step, ok, `Dijiste ${fmt(v)}; la respuesta es ${fmt(q.answer)}.`);
      });
    }
  });

  const st0 = getState();
  const done = document.getElementById('action-done') as HTMLInputElement;
  const note = document.getElementById('note') as HTMLTextAreaElement;
  done.checked = !!st0.actions[id];
  note.value = st0.notes[id] ?? '';
  done.addEventListener('change', () => { const s = getState(); if (done.checked) s.actions[id] = new Date().toISOString(); else delete s.actions[id]; saveState(s); });
  note.addEventListener('input', () => { const s = getState(); s.notes[id] = note.value; saveState(s); });

  function finish() {
    let s = getState();
    const first = !s.completed[id];
    s = completeSession(s, id, first ? SD.skills : []); saveState(s);
    // Evento anónimo (solo módulo y aciertos) para medir la fidelización; sin datos personales.
    if (first) try { track('sesion_completada', { modulo: root.dataset.track ?? '', aciertos: [...answered.values()].filter(Boolean).length }); } catch { /* */ }
    const correct = [...answered.values()].filter(Boolean).length;
    document.getElementById('f-score')!.textContent = `${correct}/${qSteps.length}`;
    const k = streak(s.activity, s.activity[s.activity.length - 1]);
    document.getElementById('f-streak')!.textContent = `${k.current} ${k.current === 1 ? 'día' : 'días'}`;
    document.getElementById('f-progress')!.textContent = `${root.dataset.index}/${root.dataset.total}`;
    const rec = document.getElementById('rec-next');
    if (rec) showRecommendation(rec, { exclude: id, lastTrack: root.dataset.track });
  }

  prevBtn.addEventListener('click', () => show(cur - 1));
  nextBtn.addEventListener('click', () => show(cur + 1));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' && !nextBtn.disabled && !nextBtn.hidden && !(e.target as HTMLElement).matches('input, textarea')) show(cur + 1);
    if (e.key === 'ArrowLeft' && !(e.target as HTMLElement).matches('input, textarea') && cur > 0 && cur < total - 1) show(cur - 1);
  });
  show(0);
</script>
