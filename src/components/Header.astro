---
import Logo from './Logo.astro';
import Drawer from './Drawer.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/es/mi-plan/', label: 'Mi plan' },
  { href: '/es/modulos/', label: 'Módulos' },
  { href: '/es/tutor/', label: 'Tutor' },
  { href: '/es/herramientas/', label: 'Herramientas' },
  { href: '/es/brokers/', label: 'Brókeres' },
  { href: '/es/glosario/', label: 'Glosario' },
];
const isCurrent = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <button type="button" class="icon-btn drawer-btn" data-drawer-open aria-controls="drawer" aria-expanded="false" aria-label="Abrir formaciones">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <a href="/es/" class="brand" aria-label="umotion Academy, inicio"><Logo /></a>
    <nav aria-label="Principal" class="main-nav" id="main-nav">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a href="/es/cuenta/" class="icon-btn account-btn" data-account-link aria-label="Mi cuenta y recordatorios">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="acc-dot" aria-hidden="true"></span>
      </a>
      <a href="/es/buscar/" class="icon-btn" aria-label="Buscar">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </a>
      <div class="theme-switch" role="group" aria-label="Tema de color">
        <button type="button" data-set-theme="light" aria-pressed="true">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="t-label">Claro</span>
        </button>
        <button type="button" data-set-theme="dark" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <span class="t-label">Oscuro</span>
        </button>
      </div>
      <a class="btn small cta" href="/es/empezar/">Empieza gratis</a>
    </div>
  </div>
</header>
<Drawer />

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: var(--header); }
  .brand { color: var(--ink); text-decoration: none; display: inline-flex; flex: none; }
  .main-nav { margin-left: auto; }
  .account-btn { position: relative; }
  .acc-dot { display: none; position: absolute; top: 7px; right: 7px; width: 8px; height: 8px; border-radius: 999px; background: var(--gain); box-shadow: 0 0 0 2px var(--paper); }
  .account-btn.signed-in .acc-dot { display: block; }
  .main-nav ul { list-style: none; display: flex; gap: 0.1rem; margin: 0; padding: 0; }
  .main-nav a { display: block; white-space: nowrap; padding: 0.5rem 0.7rem; border-radius: 999px; color: var(--ink-2); text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  .main-nav a:hover { background: var(--paper-2); color: var(--ink); }
  .main-nav a[aria-current='page'] { color: var(--ink); background: var(--paper-2); }
  .actions { display: flex; gap: 0.25rem; align-items: center; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px; border: 0; background: transparent; color: var(--ink-2); cursor: pointer; }
  .icon-btn:hover { background: var(--paper-2); color: var(--ink); }
  .cta { margin-left: 0.3rem; white-space: nowrap; }
  .theme-switch { display: inline-flex; padding: 3px; border-radius: 999px; background: var(--paper-2); border: 1px solid var(--rule); margin: 0 0.2rem; }
  .theme-switch button { display: inline-flex; align-items: center; gap: 0.35rem; border: 0; background: transparent; color: var(--ink-3); font: 600 0.82rem/1 var(--sans); padding: 0.45rem 0.7rem; border-radius: 999px; cursor: pointer; min-height: 34px; }
  .theme-switch button:hover { color: var(--ink); }
  .theme-switch button[aria-pressed='true'] { background: var(--card); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / 15%); }
  @media (max-width: 1240px) { .theme-switch .t-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .theme-switch button { padding: 0.45rem 0.55rem; } }
  .drawer-btn { margin-left: -0.6rem; flex: none; }
  @media (max-width: 1180px) {
    .main-nav { display: none; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 480px) { .cta { display: none; } .brand :global(.word) { display: none; } }
</style>
