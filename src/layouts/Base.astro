---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import Consent from '../components/Consent.astro';
import Analytics from '@vercel/analytics/astro';
import { SITE } from '../config/site';

export interface Alternate { lang: string; href: string }
interface Props {
  title: string;
  description: string;
  /** Ruta canónica (sin dominio). Por defecto, la ruta actual sin parámetros. */
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  alternates?: Alternate[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Permite anuncios en esta página (se exige contenido suficiente). */
  allowAds?: boolean;
  /** Oculta la barra inferior móvil (por ejemplo, durante una sesión). */
  focusMode?: boolean;
}

const {
  title, description, canonical, noindex = false, lang = 'es', alternates = [], jsonLd,
  ogType = 'website', allowAds = false, focusMode = false,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const prototype = !SITE.indexable;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <>
        {prototype && <meta name="robots" content="noindex, nofollow" data-prototype="true" />}
        <link rel="canonical" href={canonicalURL.href} />
      </>}
  {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site).href} />)}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
  <meta property="og:image" content={new URL('/og-default.png', site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f8f9fc" />
  <link rel="icon" href="/brand/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/brand/icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline>
    document.documentElement.classList.add('js');
    var t = 'light';
    try { var saved = localStorage.getItem('uacademy:theme'); if (saved === 'dark' || saved === 'light') t = saved; } catch (e) {}
    document.documentElement.dataset.theme = t;
  </script>
  {/* JSON-LD: «<» se escapa para que un dato nunca pueda cerrar la etiqueta <script>. */}
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, "\\u003c")} />)}
  <Consent allowAds={allowAds} />
  <script is:inline>
    // Analítica de Vercel sin cookies: se envía solo la ruta, nunca los parámetros (búsquedas, preguntas del tutor…).
    window.webAnalyticsBeforeSend = function (e) { try { var u = new URL(e.url); u.search = ''; u.hash = ''; return Object.assign({}, e, { url: u.toString() }); } catch (err) { return e; } };
  </script>
  <Analytics />
</head>
<body data-ads={allowAds ? 'allowed' : 'blocked'} class={focusMode ? 'focus-mode' : undefined}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer />
  {!focusMode && <BottomBar />}
  <script>
    import { initGlossaryPopovers } from '../scripts/glossary';
    import { initThemeToggle } from '../scripts/theme';
    import { boot } from '../scripts/boot';
    initThemeToggle();
    boot();
    initGlossaryPopovers();
    document.querySelectorAll<HTMLElement>('.table-wrap:not([tabindex])').forEach((el) => { el.tabIndex = 0; el.setAttribute('role', 'region'); el.setAttribute('aria-label', 'Tabla (desplazable)'); });
    const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io?.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' }) : null;
    document.querySelectorAll('.reveal').forEach((el) => (io ? io.observe(el) : el.classList.add('is-in')));
  </script>
</body>
</html>
